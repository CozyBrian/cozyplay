<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same as cozyplay.entitlements but WITHOUT com.apple.security.get-task-allow.
	     That debug flag makes macOS refuse to launch the app on any machine other than
	     the one that built it — strip it for anything you copy to another laptop. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
