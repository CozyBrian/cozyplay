<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Core Audio process tap to capture system audio. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Deliberately NOT sandboxed: we spawn helper processes (snapserver/snapclient)
	     that open listening TCP sockets and a /tmp FIFO, which App Sandbox forbids.
	     (No com.apple.security.app-sandbox key.) -->

	<!-- The bundled Snapcast helpers link dylibs (flac, opus, boost, …) that are not
	     signed with our Team ID, which trips Hardened Runtime library validation.
	     Simplest path for development. For distribution, prefer re-signing the helpers
	     and their dylibs with your Developer ID (@loader_path) and removing this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
