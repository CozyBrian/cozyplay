<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Core Audio process tap to capture system audio. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Not sandboxed (by choice, not necessity): the in-process engine only needs
	     network client/server + audio-input, which the sandbox permits, but staying
	     unsandboxed avoids churn while the engine stabilizes.
	     (No com.apple.security.app-sandbox key.) -->
</dict>
</plist>
