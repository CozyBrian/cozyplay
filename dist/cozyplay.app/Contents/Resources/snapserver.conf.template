# cozyplay bundles this as a reference. The app currently starts snapserver with an
# inline -s source (see SnapcastServer.swift), so this file is optional — use it if
# you prefer a config file (snapserver -c snapserver.conf).
#
# Stream source: raw PCM from the FIFO the app writes to.
#   sampleformat = <rate>:<bits>:<channels>   — INTEGER PCM only (16/24/32), not float
#   codec        = flac (default, ~26ms) | pcm (no codec latency) | opus | ogg
[stream]
source = pipe:///tmp/cozyplay.fifo?name=cozyplay&sampleformat=48000:16:2&codec=flac

# Playback buffer in ms. Hard floor is ~400 (values below are clamped). This is the
# uniform delay between real system audio and what the speakers play. 400–600 is
# realistic on good 5GHz Wi-Fi; raise it on congested 2.4GHz if you hear dropouts.
buffer = 500

# chunk size the server reads/sends
chunk_ms = 20

[http]
enabled = true
# built-in web UI + WebSocket JSON-RPC on 1780 (handy for debugging)

[tcp]
enabled = true
# control JSON-RPC on 1705; audio stream on 1704
